# Backend server
PORT=4000
NODE_ENV=development

# Frontend address
CLIENT_URL=http://localhost:5173

# PostgreSQL database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fingerprint_auth

# WebAuthn configuration
RP_NAME=Fingerprint Authentication System
RP_ID=localhost
EXPECTED_ORIGIN=http://localhost:5173

# Session security
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_bytes